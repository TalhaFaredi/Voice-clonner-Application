APP_ENV=development
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_DAYS=7
PORT=8010
# Production behind Nginx: exact number of reverse proxies (1). Leave 0 for direct access.
TRUSTED_PROXY_COUNT=0
TTS_DEVICE=cuda:0
CLONE_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-Base
PRESET_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE=
STRIPE_STARTER_YEARLY_PRICE=
STRIPE_CREATOR_MONTHLY_PRICE=
STRIPE_CREATOR_YEARLY_PRICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=accounts@example.com
