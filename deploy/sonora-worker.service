[Unit]
Description=Sonora GPU worker
After=network.target

[Service]
User=sonora
WorkingDirectory=/srv/sonora/backend
ExecStart=/srv/sonora/.venv/bin/python -m app.worker
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/sonora/backend/storage

[Install]
WantedBy=multi-user.target
