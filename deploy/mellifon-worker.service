[Unit]
Description=Mellifon GPU worker
After=network.target

[Service]
User=mellifon
WorkingDirectory=/srv/mellifon/backend
ExecStart=/srv/mellifon/.venv/bin/python -m app.worker
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/mellifon/backend/storage

[Install]
WantedBy=multi-user.target
